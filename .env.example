# Copy to .env.local. Keep credentials out of Git.
# Local mode stores data in .ontime/data; no Tiger Data account is required.
DATABASE_MODE=local
LOCAL_DATABASE_PATH=.ontime/data
API_PORT=3001
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# To use Tiger Data: set DATABASE_MODE=tiger and supply the dashboard URL,
# including its required TLS parameters. Do not disable certificate verification.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# The frontend Worker uses API_BASE_URL from .dev.vars if API_PORT is changed.
# API_BASE_URL=http://127.0.0.1:3001

# Google sign-in. Create an OAuth 2.0 Web application client in the Google Cloud
# console, then add the redirect URI below to its "Authorised redirect URIs".
# Leave both blank to hide the "Continue with Google" button.
# GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# Defaults to the first APP_ORIGIN plus /api/auth/google/callback. Google must send
# the browser back to the frontend origin so the session cookie lands on it.
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Ticketmaster Discovery API Consumer Key. It remains server-only.
# TICKETMASTER_API_KEY=
